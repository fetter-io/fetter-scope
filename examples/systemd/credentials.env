# /etc/fetter-scope/credentials.env: root-owned, mode 0600. systemd reads it as root and hands
# it to the service as the credential `dotenv` ($CREDENTIALS_DIRECTORY/dotenv); it is never put
# in the environment, so fetter does not inherit it. The file must exist for the service to
# start, even if empty (mail disabled).
REPORT_EMAIL_FROM=fetter@example.org
REPORT_EMAIL_TO=you@example.org
POSTMARK_SERVER_TOKEN=
# for transport = "smtp":
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_TLS=starttls
